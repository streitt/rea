{
  "name": "@streitt/sheet-counter",
  "version": "0.1.0",
  "description": "Counts stacked sheets (drywall, plywood, MDF, plates) in a photo of the stack edge.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "demo": "npm run build && node demo/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.2"
  }
}
